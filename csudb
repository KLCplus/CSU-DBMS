#!/usr/bin/env bash

set -e

CSUDB_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
CSUDB_BINARY="${CSUDB_BUILD_DIR:-${CSUDB_ROOT}/build_debug}/bin/csudb"

show_launcher_help()
{
  echo "CSUDB 2026 development launcher"
  echo
  echo "Usage:"
  echo "  ./csudb [options]        Start the CSUDB client"
  echo "  ./csudb --help           Show client options"
  echo "  ./csudb --version        Show the version"
  echo
  echo "Build first with: ./build.sh debug --make -j4"
}

if [[ ! -x "${CSUDB_BINARY}" ]]; then
  show_launcher_help
  echo
  echo "Error: ${CSUDB_BINARY} was not found. Build CSUDB first." >&2
  exit 1
fi

case "${1:-}" in
  --launcher-help)
    show_launcher_help
    ;;
  *)
    exec "${CSUDB_BINARY}" "$@"
    ;;
esac
